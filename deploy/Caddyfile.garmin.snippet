# ==============================================================================
# Garmin Monitor — Caddy v2.11.7 reverse-proxy snippet for /opt/pepnet/caddy/Caddyfile
# ==============================================================================
# 1. Generate a bcrypt password hash using the running Caddy container:
#      docker exec -it caddy caddy hash-password
# 2. Replace <BCRYPT_PASSWORD_HASH> below with the generated $2a$14$... hash.
# 3. Append this block to /opt/pepnet/caddy/Caddyfile and reload Caddy:
#      docker exec caddy caddy reload --config /etc/caddy/Caddyfile
# ==============================================================================

garmin.pepnet.at {
	encode zstd gzip

	basic_auth {
		josef <BCRYPT_PASSWORD_HASH>
	}

	reverse_proxy garmin-monitor:8000 {
		health_uri /api/healthz
		health_interval 30s
		health_timeout 5s
	}
}
