# ==============================================================================
# Garmin Monitor - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials and paths.
# The '.env' file is ignored by Git to keep your credentials secure.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Garmin Connect Credentials & Token Storage
# ------------------------------------------------------------------------------
# Garmin Connect account email and password.
# Used by 'python-garminconnect' during interactive login to generate session tokens.
# Once tokens are bootstrapped into GARMIN_TOKEN_DIR, the service uses cached tokens
# for headless synchronization without sending raw credentials on every request.
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_garmin_password_here

# Directory where Garmin OAuth / session tokens will be persisted.
# - For local development: ./data/garmin_tokens
# - For Docker / Production container: /data/garmin_tokens
GARMIN_TOKEN_DIR=./data/garmin_tokens

# ------------------------------------------------------------------------------
# 2. Database Storage
# ------------------------------------------------------------------------------
# Path to the SQLite database file (WAL mode enabled).
# - For local development: ./data/garmin.db
# - For Docker / Production container: /data/garmin.db
DATABASE_PATH=./data/garmin.db

# ------------------------------------------------------------------------------
# 3. Application & Synchronization Settings
# ------------------------------------------------------------------------------
# Timezone for local date calculations and ISO-8601 week training aggregation.
# Default: Europe/Vienna
TZ=Europe/Vienna

# Periodic background synchronization interval in hours (default: 2 hours).
SYNC_INTERVAL_HOURS=2

# Number of historical days to backfill when initializing an empty database (default: 90 days).
SYNC_BACKFILL_DAYS=90

# Application log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 4. Server Binding (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------
# IP address and port to bind the FastAPI application server.
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 5. Docker Deployment (Optional / Production)
# ------------------------------------------------------------------------------
# Image tag used by docker-compose.yml (defaults to 'latest' if unset)
IMAGE_TAG=latest
